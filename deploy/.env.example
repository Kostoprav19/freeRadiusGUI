# ---------- Image ----------
APP_IMAGE_NAME=freeradiusgui
APP_IMAGE_TAG=latest

# ---------- App ----------
APP_PORT=8080

# ---------- Database (Container Initialization) ----------
# These variables are only used to configure the mysql database in a container.
# IMPORTANT: For Java app you must configure the matching JDBC connection details
# in deploy/config.properties.
MYSQL_USER=freeradius
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=freeradiusgui
