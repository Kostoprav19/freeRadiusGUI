# deploy/config.properties — example.
# Copy this to deploy/config.properties and edit your settings.
# It will be mounted into the app container by compose.yaml.

#----- PATH TO FREERADIUS CONFIG AND LOG FILES ---
usersfilepath = /etc/freeradius/users
clientsfilepath = /etc/freeradius/clients.conf
logfilesdirpath = /var/log/freeradius/radacct

#----- DATABASE -----
# Ensure dbUser and dbPassword match MYSQL_USER and MYSQL_PASSWORD in .env
dbDriverClass = com.mysql.cj.jdbc.Driver
dbUrl = jdbc:mysql://db:3306/freeradiusgui?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
dbUser = freeradius
dbPassword = changeme
dbMinPoolSize = 5
dbMaxPoolSize = 20
dbCheckoutTimeout = 1800

#----- MAIL -----
# Rejected-RADIUS-request notifications are opt-in. Set mailEnabled = true
# to send them; defaults to false (skips SMTP setup at startup).
mailEnabled = false
mailFrom = alerts@example.com
mailTo = ops@example.com
mailSmtpServer = smtp.example.com

#----- SHELL COMMANDS -----
# Status pgreps see the host PID namespace because of pid: host.
shellPgrepFreeradius = pgrep -fl freeradius
shellPgrepTomcat = pgrep -fl tomcat
shellPgrepMysql = pgrep -fl mysqld

# Recommended recipe: nsenter into PID 1's namespaces to talk to the
# host systemd. Adjust to your host systemd unit name.
shellStartFreeradius = nsenter --target 1 --mount --uts --ipc --net --pid systemctl start freeradius
shellStopFreeradius = nsenter --target 1 --mount --uts --ipc --net --pid systemctl stop freeradius
