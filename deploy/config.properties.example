# deploy/config.properties — example.
# Copy this to deploy/config.properties and edit your settings.
# It will be mounted into the app container by compose.yaml.

#----- PATH TO FREERADIUS CONFIG AND LOG FILES ---
usersfilepath = /etc/freeradius/users
clientsfilepath = /etc/freeradius/clients.conf
logfilesdirpath = /var/log/freeradius/radacct

#----- DATABASE -----
# Ensure dbUser and dbPassword match MYSQL_USER and MYSQL_PASSWORD in .env
dbDriverClass = com.mysql.cj.jdbc.Driver
dbUrl = jdbc:mysql://db:3306/freeradiusgui?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
dbUser = freeradius
dbPassword = changeme
dbMinPoolSize = 5
dbMaxPoolSize = 20
dbCheckoutTimeout = 1800

#----- MAIL -----
# Rejected-RADIUS-request notifications are opt-in. Set mailEnabled = true
# to send them; defaults to false (skips SMTP setup at startup).
mailEnabled = false
mailFrom = alerts@example.com
mailTo = ops@example.com
mailSmtpServer = smtp.example.com

#----- APP -----
appVersion = 1.0.2

#----- SHELL COMMANDS -----
# freeradius runs in a sibling container. Its status and restart go through the
# Docker API over the mounted /var/run/docker.sock (see compose.yaml). This
# needs no shared PID namespace; restarting freeradius does not affect the app.
# (Requires the docker.sock mount; that grants root-on-host access.)
shellPgrepFreeradius = curl -s --unix-socket /var/run/docker.sock http://localhost/containers/freeradius/json | grep -oE '"Running": *true'
shellPgrepMysql = curl -s --unix-socket /var/run/docker.sock http://localhost/containers/db/json | grep -oE '"Running": *true'
# Restart applies both users and clients.conf changes (full daemon restart).
shellRestartFreeradius = curl -s -X POST --unix-socket /var/run/docker.sock http://localhost/containers/freeradius/restart
