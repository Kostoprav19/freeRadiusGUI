# Copy to `lab/.env` and edit as needed. `docker compose` reads .env
# automatically when invoked from `lab/`. All values here already match the
# `${VAR:-default}` fallbacks in `compose.yaml`, so the stack also works with
# no `.env` at all — this file is purely for overriding defaults.

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=freeradiusgui
MYSQL_USER=freeradius
MYSQL_PASSWORD=koJasmoJas2
# Host port the MySQL container binds to. Change if 3306 is already in use.
MYSQL_PORT=3306

# ---------- App (only used with `--profile app`) ----------
APP_PORT=8080
# ---------- App config overrides (optional) ----------
# Uncomment to override app config.properties defaults.
# NOTE: if you override DB_USER / DB_PASSWORD below, also update
# MYSQL_USER / MYSQL_PASSWORD above so MySQL credentials stay aligned.
#DB_URL=jdbc:mysql://db:3306/freeradiusgui?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
#DB_USER=freeradius
#DB_PASSWORD=koJasmoJas2
#DB_DRIVER=com.mysql.cj.jdbc.Driver
#DB_MIN_POOL=5
#DB_MAX_POOL=20
#DB_CHECKOUT_TIMEOUT_MS=1800
#MAIL_ENABLED=false
#MAIL_FROM=freeradius1@local
#MAIL_TO=help@local
#MAIL_SMTP_SERVER=10.0.0.100
#FREERADIUSGUI_USERS_FILE=/etc/freeradius/users
#FREERADIUSGUI_CLIENTS_FILE=/etc/freeradius/clients.conf
#FREERADIUSGUI_RADACCT_DIR=/var/log/freeradius/radacct

# ---------- FreeRADIUS dev server (only used with `--profile app`) ----------
# Host UDP ports the freeradius container binds to.
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
# Seconds between radclient bursts.
RADCLIENT_INTERVAL=5
